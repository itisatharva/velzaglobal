# ======================================================================
# VELZA GLOBAL GROUP - MASTER .HTACCESS
# ======================================================================
#
# CANONICAL WEBSITE:
# https://www.velzaglobal.com/
#
# LOCKED STANDARD:
# - HTTPS
# - WWW canonical hostname
# - Extensionless public page URLs
# - Physical .html / .htm / .php files may remain on server
# - /.well-known/ protected for standards-based infrastructure
# - robots.txt and sitemap.xml remain publicly accessible
# - Search engines / AI crawlers are not blocked here
#
# ======================================================================


# ======================================================================
# 1. BASIC APACHE OPTIONS
# ======================================================================

Options -Indexes
Options -MultiViews


# ======================================================================
# 2. DIRECTORY INDEX
# ======================================================================

DirectoryIndex index.html index.htm index.php


# ======================================================================
# 3. URL REWRITING
# ======================================================================

<IfModule mod_rewrite.c>

RewriteEngine On


# ======================================================================
# 3A. BLOCK HIDDEN FILE / DIRECTORY ACCESS
# ======================================================================
#
# BLOCKS:
# /.env
# /.git/
# /.svn/
# /folder/.secret
#
# EXCEPTION:
# /.well-known/
#
# Hidden files underneath /.well-known/ remain blocked.
# ======================================================================

RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,END]

# Block direct HTTP access to the bundled PHPMailer library used by the
# private event subsystem. Server-side PHP includes are unaffected.
RewriteRule ^Ph/Ph/Events/PR/PHPMailer(?:/|$) - [F,END,NC]

# Prevent direct web access to bundled Simple Forms internals/documentation.
# Public CSS/JS assets remain accessible; PHP can still include these files server-side.
RewriteRule ^assets/vendor/simple-forms/(?:config\.php|core(?:/|$)|help(?:/|$)|email-templates(?:/|$)) - [F,END,NC]


# ======================================================================
# 3B. ACME / SSL VALIDATION EXCEPTION
# ======================================================================
#
# Allows:
# /.well-known/acme-challenge/
#
# to be served directly.
#
# This avoids creating an HTTPS dependency during certificate validation.
# ======================================================================

RewriteRule ^\.well-known/acme-challenge(?:/|$) - [END]



# ======================================================================
# 3C. LEGACY URL REDIRECTS
# ======================================================================
#
# Preserve SEO equity from earlier hyphenated/template URLs.
# All targets go directly to the final canonical extensionless URL.
# ======================================================================

RewriteRule ^about-us(?:\.html?)?$ https://www.velzaglobal.com/aboutus [R=301,END,NC]
RewriteRule ^coffee-collection(?:\.html?)?$ https://www.velzaglobal.com/coffeecollection [R=301,END,NC]
RewriteRule ^coming-soon(?:\.html?)?$ https://www.velzaglobal.com/comingsoon [R=301,END,NC]
RewriteRule ^contact-us(?:\.html?)?$ https://www.velzaglobal.com/contactus [R=301,END,NC]
RewriteRule ^lifestyle-essentials(?:\.html?)?$ https://www.velzaglobal.com/lifestyleessentials [R=301,END,NC]
RewriteRule ^luxury-beverage(?:\.html?)?$ https://www.velzaglobal.com/luxurybeverage [R=301,END,NC]
RewriteRule ^news-1(?:\.html?)?$ https://www.velzaglobal.com/news1 [R=301,END,NC]
RewriteRule ^news-2(?:\.html?)?$ https://www.velzaglobal.com/news2 [R=301,END,NC]
RewriteRule ^privacy-policy(?:\.html?)?$ https://www.velzaglobal.com/privacypolicy [R=301,END,NC]
RewriteRule ^pure-italian-spirits(?:\.html?)?$ https://www.velzaglobal.com/pureitalianspirits [R=301,END,NC]
RewriteRule ^rosso-caffe(?:\.html?)?$ https://www.velzaglobal.com/rossocaffe [R=301,END,NC]
RewriteRule ^terms-and-conditions(?:\.html?)?$ https://www.velzaglobal.com/termsandconditions [R=301,END,NC]
RewriteRule ^page-new-news(?:\.html?)?$ https://www.velzaglobal.com/news [R=301,END,NC]


# ======================================================================
# 3D. INDEX FILE -> CANONICAL HOMEPAGE
# ======================================================================
#
# /index.html
# /index.htm
# /index.php
#
# become:
#
# https://www.velzaglobal.com/
#
# GET / HEAD only.
# ======================================================================

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.(?:html?|php)(?:[?\s]) [NC]
RewriteRule ^index\.(?:html?|php)$ https://www.velzaglobal.com/ [R=301,END]


# ======================================================================
# 3E. REMOVE .HTML / .HTM FROM PUBLIC URLS
# ======================================================================
#
# /aboutus.html -> /aboutus
# /aboutus.htm  -> /aboutus
#
# Redirect occurs only if the physical file actually exists.
# ======================================================================

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html?(?:[?\s]) [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+)\.html?$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3F. REMOVE .PHP FROM PUBLIC PAGE URLS
# ======================================================================
#
# /news.php -> /news
#
# GET / HEAD only.
#
# POST requests are NOT redirected so forms, APIs, callbacks,
# payment notifications and similar PHP processes are protected.
#
# Redirect occurs only if the physical PHP file actually exists.
# ======================================================================

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]) [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+)\.php$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3G. FORCE WWW HOSTNAME
# ======================================================================
#
# IMPORTANT:
#
# The matched RewriteRule path ($1) is used instead of REQUEST_URI.
#
# This prevents a malformed/proxy-modified REQUEST_URI from being
# repeatedly inserted into the redirect destination.
#
# Examples:
#
# https://velzaglobal.com/aboutus
# http://velzaglobal.com/aboutus
#
# ->
#
# https://www.velzaglobal.com/aboutus
# ======================================================================

RewriteCond %{HTTP_HOST} !^www\.velzaglobal\.com$ [NC]
RewriteRule ^(.*)$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3H. FORCE HTTPS - REVERSE PROXY / SSL TERMINATOR
# ======================================================================
#
# When a CDN / reverse proxy explicitly reports that the visitor used
# HTTP, redirect to HTTPS.
#
# DO NOT redirect merely because Apache %{HTTPS} is "off" when a proxy
# is present. TLS may already have been terminated upstream.
# ======================================================================

RewriteCond %{HTTP:X-Forwarded-Proto} ^http(?:\s*,|$) [NC]
RewriteRule ^(.*)$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3I. FORCE HTTPS - STANDARD FORWARDED HEADER
# ======================================================================
#
# Fallback for proxies using:
#
# Forwarded: ...;proto=http
#
# Used only when X-Forwarded-Proto is absent.
# ======================================================================

RewriteCond %{HTTP:X-Forwarded-Proto} ^$
RewriteCond %{HTTP:Forwarded} (^|[;,[:space:]])proto=http([;,[:space:]]|$) [NC]
RewriteRule ^(.*)$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3J. FORCE HTTPS - DIRECT APACHE FALLBACK
# ======================================================================
#
# Used only when Apache sees HTTP AND there are no common indications
# that a reverse proxy is handling the visitor connection.
#
# This preserves HTTP -> HTTPS behavior on a direct Apache connection
# without recreating the proxy redirect loop.
# ======================================================================

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} ^$
RewriteCond %{HTTP:Forwarded} ^$
RewriteCond %{HTTP:X-Forwarded-For} ^$
RewriteCond %{HTTP:X-Real-IP} ^$
RewriteCond %{HTTP:CF-Connecting-IP} ^$
RewriteRule ^(.*)$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3K. RESERVE REMAINING /.WELL-KNOWN/ REQUESTS
# ======================================================================
#
# ACME requests were exempted earlier.
#
# Other /.well-known/ endpoints reach this point after normal
# WWW / HTTPS canonicalization.
#
# They must NOT participate in HTML / HTM / PHP clean-URL rewriting.
# ======================================================================

RewriteRule ^\.well-known(?:/|$) - [END]


# ======================================================================
# 3L. REMOVE TRAILING SLASH FROM NON-DIRECTORY PAGE URLS
# ======================================================================
#
# /aboutus/ -> /aboutus
#
# Real physical directories are excluded.
#
# Homepage remains:
#
# /
# ======================================================================

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3M. EXTENSIONLESS URL -> EXISTING .HTML FILE
# ======================================================================
#
# Browser:
#
# https://www.velzaglobal.com/aboutus
#
# Apache internally serves:
#
# /aboutus.html
#
# No browser redirect occurs.
#
# Priority 1: .html
# ======================================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [END]


# ======================================================================
# 3N. EXTENSIONLESS URL -> EXISTING .HTM FILE
# ======================================================================
#
# Used only when no matching .html file exists.
#
# Priority 2: .htm
# ======================================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.htm -f
RewriteRule ^(.+)$ $1.htm [END]


# ======================================================================
# 3O. EXTENSIONLESS URL -> EXISTING .PHP FILE
# ======================================================================
#
# Used only when no matching .html or .htm file exists.
#
# Priority 3: .php
# ======================================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [END]


</IfModule>


# ======================================================================
# 4. CUSTOM ERROR PAGES
# ======================================================================
#
# LOCAL paths are deliberately used.
#
# This preserves the original HTTP error status.
#
# Required physical files:
#
# 400.html
# 401.html
# 403.html
# 404.html
# 500.html
# 502.html
# 503.html
# 504.html
#
# ======================================================================

ErrorDocument 400 /400
ErrorDocument 401 /401
ErrorDocument 403 /403
ErrorDocument 404 /404
ErrorDocument 500 /500
ErrorDocument 502 /502
ErrorDocument 503 /503
ErrorDocument 504 /504


# ======================================================================
# 5. PROTECT SENSITIVE FILES
# ======================================================================

<IfModule mod_authz_core.c>


# ----------------------------------------------------------------------
# Development / configuration / repository files
# ----------------------------------------------------------------------

<FilesMatch "(^\.|\.env$|\.git|\.svn|composer\.(json|lock)$|package(-lock)?\.json$|yarn\.lock$|webpack\.config\.js$|gulpfile\.js$|Gruntfile\.js$|phpunit\.xml$|README(?:\..*)?$|CHANGELOG(?:\..*)?$)">
    Require all denied
</FilesMatch>


# ----------------------------------------------------------------------
# Backup / database / shell / configuration files
# ----------------------------------------------------------------------

<FilesMatch "\.(?:bak|backup|old|orig|save|swp|sql|ini|log|lock|pid|conf|config|dist|sh|md|map|scss|sass|less|yml|yaml|toml)$">
    Require all denied
</FilesMatch>


# ----------------------------------------------------------------------
# Apache configuration/password files
# ----------------------------------------------------------------------

<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>


# ----------------------------------------------------------------------
# Protect extensionless server log filenames
# ----------------------------------------------------------------------

<FilesMatch "^(?:error_log|access_log)$">
    Require all denied
</FilesMatch>


</IfModule>


# ======================================================================
# 6. SECURITY HEADERS
# ======================================================================

<IfModule mod_headers.c>


# Prevent MIME sniffing
Header always set X-Content-Type-Options "nosniff"


# Clickjacking protection
Header always set X-Frame-Options "SAMEORIGIN"


# Referrer privacy
Header always set Referrer-Policy "strict-origin-when-cross-origin"


# Disable unnecessary browser permissions
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"


# Remove platform information if present
Header always unset X-Powered-By


# ----------------------------------------------------------------------
# HTTP STRICT TRANSPORT SECURITY
# ----------------------------------------------------------------------
#
# 1 year.
#
# includeSubDomains and preload remain deliberately disabled until every
# relevant Velza Global subdomain is confirmed permanently HTTPS-only.
#
# Browsers only honor HSTS when received over a secure connection.
# Setting the header here avoids relying on Apache-side HTTPS detection
# when TLS is terminated upstream.
# ----------------------------------------------------------------------

Header always set Strict-Transport-Security "max-age=31536000"


</IfModule>


# ======================================================================
# 7. GZIP COMPRESSION
# ======================================================================

<IfModule mod_deflate.c>

AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE text/xml
AddOutputFilterByType DEFLATE text/javascript

AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/json
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE application/xhtml+xml
AddOutputFilterByType DEFLATE application/rss+xml
AddOutputFilterByType DEFLATE application/atom+xml

AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>


# ======================================================================
# 8. BROWSER EXPIRATION / CACHING
# ======================================================================

<IfModule mod_expires.c>

ExpiresActive On


# HTML
ExpiresByType text/html "access plus 1 hour"


# CSS
ExpiresByType text/css "access plus 1 month"


# JAVASCRIPT
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"


# JSON / XML
ExpiresByType application/json "access plus 1 hour"
ExpiresByType application/xml "access plus 1 hour"
ExpiresByType text/xml "access plus 1 hour"


# IMAGES
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"


# FONTS
ExpiresByType font/woff "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/ttf "access plus 1 year"
ExpiresByType font/otf "access plus 1 year"


# VIDEO
ExpiresByType video/mp4 "access plus 1 year"
ExpiresByType video/webm "access plus 1 year"


# PDF
ExpiresByType application/pdf "access plus 1 month"


</IfModule>


# ======================================================================
# 9. CACHE-CONTROL
# ======================================================================

<IfModule mod_headers.c>


# ----------------------------------------------------------------------
# STATIC MEDIA - 1 YEAR
# ----------------------------------------------------------------------

<FilesMatch "\.(?:jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000"
</FilesMatch>


# ----------------------------------------------------------------------
# CSS / JAVASCRIPT - 1 MONTH
# ----------------------------------------------------------------------

<FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>


# ----------------------------------------------------------------------
# HTML / HTM - 1 HOUR
# ----------------------------------------------------------------------

<FilesMatch "\.(?:html|htm)$">
    Header set Cache-Control "public, max-age=3600"
</FilesMatch>


</IfModule>


# ======================================================================
# 10. DEFAULT CHARACTER ENCODING
# ======================================================================

AddDefaultCharset UTF-8


# ======================================================================
# 11. MIME TYPES
# ======================================================================

<IfModule mod_mime.c>

AddType image/webp .webp
AddType image/avif .avif
AddType image/svg+xml .svg

AddType font/woff .woff
AddType font/woff2 .woff2

AddType application/manifest+json .webmanifest

</IfModule>


# ======================================================================
# 12. DISABLE FILE ETAGS
# ======================================================================

FileETag None


# ======================================================================
# 13. SEARCH ENGINE + AI CRAWLER POLICY
# ======================================================================
#
# NO crawler-specific blocking exists in this .htaccess file.
#
# Search-engine / AI crawler policy should be managed through:
#
# /robots.txt
#
# This .htaccess therefore does not intentionally block:
#
# Googlebot
# GoogleOther
# Google-Extended
#
# Bingbot
# BingPreview
#
# OAI-SearchBot
# GPTBot
# ChatGPT-User
#
# ClaudeBot
# Claude-SearchBot
# Claude-User
# anthropic-ai
#
# PerplexityBot
# Perplexity-User
#
# Applebot
# Applebot-Extended
#
# Amazonbot
#
# Meta-ExternalAgent
# Meta-ExternalFetcher
# FacebookBot
#
# Bytespider
#
# DuckDuckBot
#
# Baiduspider
#
# YandexBot
#
# PetalBot
#
# LinkedInBot
#
# Pinterestbot
#
# YouBot
#
# CCBot
#
# Diffbot
#
# cohere-ai
#
# or other legitimate crawlers unless they are independently blocked by
# robots.txt, CDN, firewall, hosting security or another server layer.
#
# ======================================================================


# ======================================================================
# 14. IMPORTANT PUBLIC SEO FILES
# ======================================================================
#
# These remain normal public physical files:
#
# https://www.velzaglobal.com/robots.txt
#
# https://www.velzaglobal.com/sitemap.xml
#
# Because they are physical files, they are not processed by the
# extensionless HTML / HTM / PHP resolver.
#
# ======================================================================


# ======================================================================
# 15. .WELL-KNOWN POLICY
# ======================================================================
#
# /.well-known/acme-challenge/
#
# -> served directly for ACME / SSL validation
#
# Other /.well-known/ resources:
#
# -> canonical WWW / HTTPS processing first
# -> then excluded from normal website page rewriting
#
# Nested hidden files remain blocked.
#
# ======================================================================


# ======================================================================
# 16. FINAL LOCKED URL ARCHITECTURE
# ======================================================================
#
# HOMEPAGE:
#
# https://www.velzaglobal.com/
#
#
# PUBLIC PAGE:
#
# https://www.velzaglobal.com/aboutus
#
#
# NOT:
#
# http://velzaglobal.com/aboutus
# http://www.velzaglobal.com/aboutus
# https://velzaglobal.com/aboutus
# https://www.velzaglobal.com/aboutus.html
# https://www.velzaglobal.com/aboutus.htm
# https://www.velzaglobal.com/aboutus.php
# https://www.velzaglobal.com/aboutus/
#
#
# INTERNAL FILE RESOLUTION PRIORITY:
#
# 1. .html
# 2. .htm
# 3. .php
#
# ======================================================================


# ======================================================================
# END - VELZA GLOBAL GROUP MASTER .HTACCESS
# ======================================================================