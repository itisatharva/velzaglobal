# ======================================================================
# REGION-LEVEL .htaccess
# ======================================================================
# Everything global (security, https/www, legacy redirects, headers,
# caching, compression, region selection) is handled by the root
# .htaccess. This file does exactly one job:
#
#   resolve an extensionless URL to the .html file in THIS folder.
#
# Do not add redirects here. A redirect at this level would expose the
# internal /regions/<code>/ path in the address bar, which is precisely
# what the internal-rewrite architecture exists to prevent.
# ======================================================================

Options -Indexes
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Block direct access to /regions/<code>/... .
# This guard has to live here, not only in the root .htaccess: because
# this file declares its own RewriteEngine, Apache REPLACES the parent's
# per-directory rewrite ruleset instead of inheriting it, so the root's
# section 2 guard never runs for paths inside this folder.
# THE_REQUEST holds the original request line, so an internal rewrite
# from /aboutus still reads "GET /aboutus" here and passes through.
RewriteCond %{THE_REQUEST} \s/+regions/ [NC]
RewriteRule ^ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>
