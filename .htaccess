# ======================================================================
# VELZA GLOBAL GROUP - MASTER .HTACCESS  (WEB ROOT)
# ======================================================================
#
# CANONICAL WEBSITE:
# https://www.velzaglobal.com/
#
# This file lives at the DOCUMENT ROOT and is the only .htaccess for the
# public site. The regions/ subfolders deliberately have none.
#
# LOCKED STANDARD:
# - HTTPS
# - WWW canonical hostname
# - Extensionless public page URLs
# - Geo-routed regional content, URL always stays https://www.velzaglobal.com/
# - /.well-known/ protected for standards-based infrastructure
# - robots.txt and sitemap.xml remain publicly accessible
#
# DOCUMENT ROOT LAYOUT:
#   /assets/            shared CSS/JS/images/video  (one copy, all regions)
#   /region/            region config + switcher script
#   /regions/hk/*.html  Hong Kong / HQ pages   (global default)
#   /regions/ph/*.html  Philippines pages
#   /regions/in/*.html  India pages
#   /Ph/Events/PR/      RSVP / event subsystem (PHP, not geo-routed)
#   root files          robots.txt, sitemap.xml, favicons, manifest
#
# REQUIRES: Apache 2.4 (uses the END flag) + Cloudflare in front of origin.
#
# ======================================================================


# ======================================================================
# 1. BASIC APACHE OPTIONS
# ======================================================================

Options -Indexes
Options -MultiViews


# ======================================================================
# 2. DIRECTORY INDEX
# ======================================================================

DirectoryIndex index.html index.htm index.php


# ======================================================================
# 3. URL REWRITING
# ======================================================================

<IfModule mod_rewrite.c>

RewriteEngine On


# ======================================================================
# 3A. BLOCK HIDDEN FILE / DIRECTORY ACCESS
# ======================================================================
#
# BLOCKS: /.env  /.git/  /.svn/  /folder/.secret
# EXCEPTION: /.well-known/  (hidden files underneath it remain blocked)
# ======================================================================

RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,END]

# Block direct HTTP access to the bundled PHPMailer library used by the
# private event subsystem. Server-side PHP includes are unaffected.
RewriteRule ^Ph/Events/PR/PHPMailer(?:/|$) - [F,END,NC]

# Block the unfinished RSVP team portal. See section 5B for the full
# rationale and for how to re-open it behind HTTP Basic auth.
#
# This MUST live here, near the top of the ruleset, and not down in 5B:
# the shared-path passthrough in 3J matches ^Ph/ and carries [END], which
# terminates rewrite processing entirely, so any deny rule placed after it
# is unreachable and the portal stays publicly readable.
RewriteRule ^Ph/Events/PR/team(?:/|$) - [F,END,NC]

# Prevent direct web access to bundled Simple Forms internals/documentation.
# Public CSS/JS assets remain accessible; PHP can still include these files.
RewriteRule ^assets/vendor/simple-forms/(?:config\.php|core(?:/|$)|help(?:/|$)|email-templates(?:/|$)) - [F,END,NC]


# ======================================================================
# 3B. ACME / SSL VALIDATION EXCEPTION
# ======================================================================
#
# Served directly so certificate validation never depends on HTTPS.
# ======================================================================

RewriteRule ^\.well-known/acme-challenge(?:/|$) - [END]


# ======================================================================
# 3C. LEGACY URL REDIRECTS
# ======================================================================
#
# Preserve SEO equity from earlier hyphenated/template URLs.
# ======================================================================

RewriteRule ^about-us(?:\.html?)?$ https://www.velzaglobal.com/aboutus [R=301,END,NC]
RewriteRule ^coffee-collection(?:\.html?)?$ https://www.velzaglobal.com/coffeecollection [R=301,END,NC]
RewriteRule ^coming-soon(?:\.html?)?$ https://www.velzaglobal.com/comingsoon [R=301,END,NC]
RewriteRule ^contact-us(?:\.html?)?$ https://www.velzaglobal.com/contactus [R=301,END,NC]
RewriteRule ^lifestyle-essentials(?:\.html?)?$ https://www.velzaglobal.com/lifestyleessentials [R=301,END,NC]
RewriteRule ^luxury-beverage(?:\.html?)?$ https://www.velzaglobal.com/luxurybeverage [R=301,END,NC]
RewriteRule ^news-1(?:\.html?)?$ https://www.velzaglobal.com/news1 [R=301,END,NC]
RewriteRule ^news-2(?:\.html?)?$ https://www.velzaglobal.com/news2 [R=301,END,NC]
RewriteRule ^privacy-policy(?:\.html?)?$ https://www.velzaglobal.com/privacypolicy [R=301,END,NC]
RewriteRule ^pure-italian-spirits(?:\.html?)?$ https://www.velzaglobal.com/pureitalianspirits [R=301,END,NC]
RewriteRule ^rosso-caffe(?:\.html?)?$ https://www.velzaglobal.com/rossocaffe [R=301,END,NC]
RewriteRule ^terms-and-conditions(?:\.html?)?$ https://www.velzaglobal.com/termsandconditions [R=301,END,NC]
RewriteRule ^page-new-news(?:\.html?)?$ https://www.velzaglobal.com/news [R=301,END,NC]

# Legacy template URLs still linked from regions/in/. These targets never
# existed as files; send them to the correct canonical pages.
RewriteRule ^page-luxury-beverage(?:\.html?)?$ https://www.velzaglobal.com/luxurybeverage [R=301,END,NC]
RewriteRule ^page-lifestyle-essentials(?:\.html?)?$ https://www.velzaglobal.com/lifestyleessentials [R=301,END,NC]
RewriteRule ^page-pure-italian-spirits(?:\.html?)?$ https://www.velzaglobal.com/pureitalianspirits [R=301,END,NC]
RewriteRule ^page-service-item(?:\.html?)?$ https://www.velzaglobal.com/portfolio [R=301,END,NC]


# ======================================================================
# 3D. HIDE THE INTERNAL /regions/ PATH FROM PUBLIC URLS
# ======================================================================
#
# /regions/in/aboutus.html  ->  /aboutus
#
# The regional folders are an internal implementation detail. Exposing
# them publicly would create three duplicate-content copies of every page
# and let visitors bookmark a region that then ignores their preference.
#
# Matches on THE_REQUEST (the literal request line), so the INTERNAL
# rewrite in 3J below - which does not alter THE_REQUEST - never triggers
# this rule and no redirect loop is possible.
# ======================================================================

# /regions/xx/index.html (or the bare folder) -> homepage
RewriteCond %{THE_REQUEST} \s/+regions/(?:hk|ph|in)/(?:index\.html?)?(?:[?\s]) [NC]
RewriteRule ^ https://www.velzaglobal.com/ [R=301,END]

# /regions/xx/anything.html -> /anything
RewriteCond %{THE_REQUEST} \s/+regions/(?:hk|ph|in)/([A-Za-z0-9_-]+)\.html?(?:[?\s]) [NC]
RewriteRule ^ https://www.velzaglobal.com/%1 [R=301,END]


# ======================================================================
# 3E. INDEX FILE -> CANONICAL HOMEPAGE
# ======================================================================

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.(?:html?|php)(?:[?\s]) [NC]
RewriteRule ^index\.(?:html?|php)$ https://www.velzaglobal.com/ [R=301,END]


# ======================================================================
# 3F. REMOVE .HTML / .HTM FROM PUBLIC URLS
# ======================================================================
#
# /aboutus.html -> /aboutus
#
# Scoped to single-segment top-level URLs so it can never touch
# /Ph/Events/PR/index.html or anything under /assets/.
# ======================================================================

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+[A-Za-z0-9_-]+\.html?(?:[?\s]) [NC]
RewriteRule ^([A-Za-z0-9_-]+)\.html?$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3G. REMOVE .PHP FROM PUBLIC PAGE URLS
# ======================================================================
#
# GET / HEAD only. POST is never redirected, so form posts, APIs and
# callbacks under /Ph/Events/PR/ are unaffected.
#
# Scoped to single-segment top-level URLs for the same reason as 3F -
# /Ph/Events/PR/submit.php must keep its extension.
# ======================================================================

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+[A-Za-z0-9_-]+\.php(?:[?\s]) [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^([A-Za-z0-9_-]+)\.php$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3H. FORCE WWW HOSTNAME
# ======================================================================
#
# The matched RewriteRule path ($1) is used instead of REQUEST_URI. This
# prevents a malformed/proxy-modified REQUEST_URI from being repeatedly
# inserted into the redirect destination.
# ======================================================================

RewriteCond %{HTTP_HOST} !^www\.velzaglobal\.com$ [NC]
RewriteRule ^(.*)$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3I. FORCE HTTPS
# ======================================================================
#
# Cloudflare terminates TLS and forwards over HTTP(S) to the origin, so
# Apache's own %{HTTPS} is not authoritative. Trust the proxy headers
# first and only fall back to %{HTTPS} when no proxy is present -
# otherwise Cloudflare + Apache produce an infinite redirect loop.
#
# Cloudflare SSL mode MUST be "Full (strict)". In "Flexible" mode CF
# always talks HTTP to the origin, X-Forwarded-Proto is always "http",
# and this block loops forever.
# ======================================================================

# Proxy explicitly reports the visitor used HTTP.
RewriteCond %{HTTP:X-Forwarded-Proto} ^http(?:\s*,|$) [NC]
RewriteRule ^(.*)$ https://www.velzaglobal.com/$1 [R=301,END]

# Fallback for proxies using the standard Forwarded header.
RewriteCond %{HTTP:X-Forwarded-Proto} ^$
RewriteCond %{HTTP:Forwarded} (^|[;,[:space:]])proto=http([;,[:space:]]|$) [NC]
RewriteRule ^(.*)$ https://www.velzaglobal.com/$1 [R=301,END]

# Direct Apache connection with no proxy indicators at all.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} ^$
RewriteCond %{HTTP:Forwarded} ^$
RewriteCond %{HTTP:X-Forwarded-For} ^$
RewriteCond %{HTTP:X-Real-IP} ^$
RewriteCond %{HTTP:CF-Connecting-IP} ^$
RewriteRule ^(.*)$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3J. RESERVE /.WELL-KNOWN/ AND SHARED PATHS
# ======================================================================
#
# These are served from a single shared copy at the document root and
# must never be geo-routed into a region folder:
#
#   /assets/   shared CSS, JS, images, video, vendor libraries
#   /region/   region config + switcher script
#   /Ph/       RSVP / event subsystem
#
# Placed AFTER canonicalisation so these paths still get HTTPS/WWW, but
# BEFORE region resolution so they exit before any rewriting.
# ======================================================================

RewriteRule ^\.well-known(?:/|$) - [END]
RewriteRule ^(?:assets|region|Ph)(?:/|$) - [END]

# Any real file or directory at the web root (robots.txt, sitemap.xml,
# favicon.ico, site.webmanifest, apple-touch-icon.png, the logo SVG) is
# served as-is and never geo-routed.
#
# The pattern is ^(.+)$ and NOT ^ on purpose: "/" itself resolves to the
# document root, which IS a directory, so a bare ^ would match the
# homepage here and END before it ever reaches region mapping in 3M -
# producing a 404 on the homepage while every other page worked.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)$ - [END]


# ======================================================================
# 3K. REMOVE TRAILING SLASH FROM NON-DIRECTORY PAGE URLS
# ======================================================================
#
# /aboutus/ -> /aboutus     (the homepage "/" is unaffected)
# ======================================================================

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://www.velzaglobal.com/$1 [R=301,END]


# ======================================================================
# 3L. REGION RESOLUTION            <-- GEO-ROUTING, STEP 1 OF 2
# ======================================================================
#
# Decide which region folder serves this request and store it in the
# VELZA_REGION environment variable. Nothing is rewritten here.
#
# PRECEDENCE (highest first):
#
#   1. velzaRegion cookie   - an explicit, deliberate human choice made
#                             through the on-site country switcher. This
#                             ALWAYS wins, so a visitor who switches
#                             region is never bounced back by geo-IP on
#                             their next page view.
#   2. CF-IPCountry header  - Cloudflare's geo-IP lookup, injected on
#                             every request once the domain is proxied
#                             (orange cloud). Apache/cPanel has no
#                             geo-IP capability of its own.
#   3. hk                   - Hong Kong HQ is the global default and the
#                             fallback for every other country, and for
#                             CF's non-country codes (XX unknown,
#                             T1 Tor, etc).
#
# Each rule is guarded by "VELZA_REGION is still empty", which is what
# makes this an if / else-if / else chain rather than four rules that
# all fire.
#
# The cookie value is constrained to (hk|ph|in) by the regex, so a
# hand-crafted cookie cannot inject a path segment into the rewrite
# target in 3M. Anything else falls through to geo-IP.
# ======================================================================

# 1. Explicit user choice (cookie) - highest priority.
RewriteCond %{HTTP_COOKIE} (?:^|;\s*)velzaRegion=(hk|ph|in)(?:\s*;|$) [NC]
RewriteRule ^ - [E=VELZA_REGION:%1]

# 2. Cloudflare geo-IP - only when no valid cookie was present.
RewriteCond %{ENV:VELZA_REGION} ^$
RewriteCond %{HTTP:CF-IPCountry} ^IN$ [NC]
RewriteRule ^ - [E=VELZA_REGION:in]

RewriteCond %{ENV:VELZA_REGION} ^$
RewriteCond %{HTTP:CF-IPCountry} ^PH$ [NC]
RewriteRule ^ - [E=VELZA_REGION:ph]

# 3. Default: Hong Kong HQ (covers HK itself and every other country).
RewriteCond %{ENV:VELZA_REGION} ^$
RewriteRule ^ - [E=VELZA_REGION:hk]


# ======================================================================
# 3M. REGION MAPPING               <-- GEO-ROUTING, STEP 2 OF 2
# ======================================================================
#
# Internal rewrite only - no [R] flag, so the browser address bar keeps
# showing https://www.velzaglobal.com/aboutus while Apache serves
# /regions/in/aboutus.html from disk.
#
# NOTE ON RELATIVE ASSET PATHS:
# The page HTML references assets relatively ("assets/css/theme.css").
# Because the browser's URL is /aboutus, those resolve to /assets/... at
# the web root - which is exactly where the single shared asset copy
# lives. This is why assets MUST NOT be moved back inside the region
# folders; doing so breaks every stylesheet and image under geo-routing.
# ======================================================================

# Homepage
RewriteRule ^$ regions/%{ENV:VELZA_REGION}/index.html [END]

# Extensionless page URLs -> that region's HTML file.
# The -f test means a page missing from one region falls through to the
# 404 handler rather than serving another region's copy.
RewriteCond %{DOCUMENT_ROOT}/regions/%{ENV:VELZA_REGION}/$1.html -f
RewriteRule ^([A-Za-z0-9_-]+)$ regions/%{ENV:VELZA_REGION}/$1.html [END]


</IfModule>


# ======================================================================
# 4. CUSTOM ERROR PAGES
# ======================================================================
#
# Local paths, so the original HTTP status is preserved. These route
# back through the region mapper above, giving each region its own
# error pages.
# ======================================================================

ErrorDocument 400 /400
ErrorDocument 401 /401
ErrorDocument 403 /403
ErrorDocument 404 /404
ErrorDocument 500 /500
ErrorDocument 502 /502
ErrorDocument 503 /503
ErrorDocument 504 /504


# ======================================================================
# 5. PROTECT SENSITIVE FILES
# ======================================================================

<IfModule mod_authz_core.c>

# ----------------------------------------------------------------------
# Development / configuration / repository files
# ----------------------------------------------------------------------

<FilesMatch "(^\.|\.env$|\.git|\.svn|composer\.(json|lock)$|package(-lock)?\.json$|yarn\.lock$|webpack\.config\.js$|gulpfile\.js$|Gruntfile\.js$|phpunit\.xml$|README(?:\..*)?$|CHANGELOG(?:\..*)?$)">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# Backup / database / shell / configuration files
# ----------------------------------------------------------------------

<FilesMatch "\.(?:bak|backup|old|orig|save|swp|sql|ini|log|lock|pid|conf|config|dist|sh|md|map|scss|sass|less|yml|yaml|toml)$">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# Apache configuration/password files
# ----------------------------------------------------------------------

<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# Protect extensionless server log filenames
# ----------------------------------------------------------------------

<FilesMatch "^(?:error_log|access_log)$">
    Require all denied
</FilesMatch>

</IfModule>


# ======================================================================
# 5B. RSVP ADMIN ENDPOINTS - CLOSED BY DEFAULT
# ======================================================================
#
# host_view.php renders every registrant's name, email, phone number,
# emergency contact person and emergency number in a plain HTML table,
# and ?toggle&id=N mutates rows. update_issue.php mutates rows too.
# NEITHER performs any authentication or CSRF check, so before this
# block they were readable and writable by anyone with the URL.
#
# team/ is an unfinished portal whose login.php validates a CSRF token
# and then never checks credentials.
#
# The August 2026 press conference these serve has already taken place,
# so denying them is not expected to interrupt anything.
#
# TO RE-ENABLE FOR EVENT STAFF, replace the "Require all denied" lines
# below with HTTP Basic auth - do NOT simply delete this block:
#
#   AuthType Basic
#   AuthName "Velza Event Staff"
#   AuthUserFile /home/velzhsrg/private_config/.htpasswd
#   Require valid-user
#
# Create that file over SSH with:  htpasswd -c <path> <username>
# ======================================================================

<IfModule mod_authz_core.c>

<Files "host_view.php">
    Require all denied
</Files>

<Files "update_issue.php">
    Require all denied
</Files>

</IfModule>

# The team/ portal is blocked by a rewrite rule in section 3A rather than
# here - see the comment there for why placement matters.


# ======================================================================
# 6. SECURITY HEADERS
# ======================================================================

<IfModule mod_headers.c>

# Prevent MIME sniffing
Header always set X-Content-Type-Options "nosniff"

# Clickjacking protection
Header always set X-Frame-Options "SAMEORIGIN"

# Referrer privacy
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Disable unnecessary browser permissions
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

# Remove platform information if present
Header always unset X-Powered-By

# ----------------------------------------------------------------------
# HTTP STRICT TRANSPORT SECURITY
# ----------------------------------------------------------------------
#
# 1 year. includeSubDomains and preload remain deliberately disabled
# until every Velza Global subdomain is confirmed permanently HTTPS-only
# (note: a staging subdomain would be caught by includeSubDomains).
# ----------------------------------------------------------------------

Header always set Strict-Transport-Security "max-age=31536000"

</IfModule>


# ======================================================================
# 7. GZIP COMPRESSION
# ======================================================================

<IfModule mod_deflate.c>

AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE text/xml
AddOutputFilterByType DEFLATE text/javascript

AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/json
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE application/xhtml+xml
AddOutputFilterByType DEFLATE application/rss+xml
AddOutputFilterByType DEFLATE application/atom+xml

AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>


# ======================================================================
# 8. BROWSER EXPIRATION / CACHING
# ======================================================================

<IfModule mod_expires.c>

ExpiresActive On

# HTML - see section 9 for the geo-routing caching constraint.
ExpiresByType text/html "access plus 0 seconds"

ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"

ExpiresByType application/json "access plus 1 hour"
ExpiresByType application/xml "access plus 1 hour"
ExpiresByType text/xml "access plus 1 hour"

ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"

ExpiresByType font/woff "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/ttf "access plus 1 year"
ExpiresByType font/otf "access plus 1 year"

ExpiresByType video/mp4 "access plus 1 year"
ExpiresByType video/webm "access plus 1 year"

ExpiresByType application/pdf "access plus 1 month"

</IfModule>


# ======================================================================
# 9. CACHE-CONTROL
# ======================================================================
#
# ### READ THIS BEFORE CHANGING ANY HTML CACHING ###
#
# HTML responses now VARY BY VISITOR: the same URL returns Indian,
# Philippine or Hong Kong content depending on the velzaRegion cookie
# and the CF-IPCountry header. Any shared cache that stores one visitor's
# HTML and replays it to another will serve the WRONG REGION.
#
# The previous "public, max-age=3600" on HTML was safe for a single-region
# site and is NOT safe now - it would let Cloudflare, a corporate proxy or
# an ISP cache hand India's homepage to a Hong Kong visitor. HTML is
# therefore private and revalidated on every request.
#
# Static assets are identical for every region and stay aggressively
# cached, so this costs essentially nothing - the HTML document is a few
# tens of KB and the multi-MB media is untouched.
#
# CLOUDFLARE: the free tier does not cache HTML by default, which is
# correct here. Do NOT add a "Cache Everything" page rule for
# velzaglobal.com/* - it would cache the geo-routed HTML at the edge and
# break regional routing for everyone. If HTML edge caching is ever
# genuinely needed it requires a Custom Cache Key that includes
# CF-IPCountry and the velzaRegion cookie (an Enterprise feature).
# ======================================================================

<IfModule mod_headers.c>

# ----------------------------------------------------------------------
# STATIC MEDIA - 1 YEAR (identical for all regions, safe to share)
# ----------------------------------------------------------------------

<FilesMatch "\.(?:jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000"
</FilesMatch>

# ----------------------------------------------------------------------
# CSS / JAVASCRIPT - 1 MONTH (identical for all regions, safe to share)
# ----------------------------------------------------------------------

<FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# ----------------------------------------------------------------------
# HTML - PER-VISITOR, NEVER SHARED
# ----------------------------------------------------------------------

<FilesMatch "\.(?:html|htm)$">
    Header set Cache-Control "private, no-cache, max-age=0, must-revalidate"
    Header set Vary "CF-IPCountry, Cookie"
</FilesMatch>

</IfModule>


# ======================================================================
# 10. DEFAULT CHARACTER ENCODING
# ======================================================================

AddDefaultCharset UTF-8


# ======================================================================
# 11. MIME TYPES
# ======================================================================

<IfModule mod_mime.c>

AddType image/webp .webp
AddType image/avif .avif
AddType image/svg+xml .svg

AddType font/woff .woff
AddType font/woff2 .woff2

AddType application/manifest+json .webmanifest

</IfModule>


# ======================================================================
# 12. DISABLE FILE ETAGS
# ======================================================================

FileETag None


# ======================================================================
# 13. SEARCH ENGINE + AI CRAWLER POLICY
# ======================================================================
#
# No crawler-specific blocking exists in this file. Crawler policy is
# managed through /robots.txt.
#
# GEO-ROUTING NOTE: crawlers are geo-routed like any other visitor.
# Googlebot crawls predominantly from US IP space, so it will index the
# Hong Kong (default) content. That is the intended canonical version -
# sitemap.xml lists only the canonical www.velzaglobal.com URLs, and the
# /regions/ paths are 301'd away in section 3D so no duplicate-content
# copies are discoverable.
# ======================================================================


# ======================================================================
# 14. FINAL LOCKED URL ARCHITECTURE
# ======================================================================
#
# HOMEPAGE:     https://www.velzaglobal.com/
# PUBLIC PAGE:  https://www.velzaglobal.com/aboutus
#
# NOT:
#   http://velzaglobal.com/aboutus
#   https://velzaglobal.com/aboutus
#   https://www.velzaglobal.com/aboutus.html
#   https://www.velzaglobal.com/aboutus/
#   https://www.velzaglobal.com/regions/in/aboutus.html
#
# The visitor's region is never visible in the URL.
#
# ======================================================================
# END - VELZA GLOBAL GROUP MASTER .HTACCESS
# ======================================================================
